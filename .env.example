# Copy this file to `.env` and fill in the real value.
#   PowerShell:  Copy-Item .env.example .env
#
# `.env` is gitignored. This file is committed so anyone cloning the repo
# (including you, six months from now) knows which variables are required.

# Neon Postgres connection string.
#
# Get it from the Neon console: your project -> "Connect" -> copy the
# connection string. Use the POOLED connection (the host contains
# "-pooler"). Neon's pooler matters here because Horizon runs short-lived
# containers that open and close connections constantly; the pooler keeps
# that from exhausting Postgres' connection limit.
#
# Neon appends `?sslmode=require` to the URL it shows you. asyncpg does not
# understand that query parameter and will raise
# `invalid dsn: invalid connection option "sslmode"`, so strip it — the
# code passes `ssl="require"` explicitly instead.
#
# Format:
#   postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb

# --- the terminal client only (client.py); the server does not read these ---

# Google AI Studio key for the Gemini model the agent runs on.
#   https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key

# Prefect Horizon API key, for talking to the *deployed* server with
# `client.py --remote`. Not needed for the local server.
#   https://horizon.prefect.io
HORIZON_API_KEY=your-horizon-api-key

# Shared between the web app and the server. The app authenticates once with
# its own API key and then names which of its users each request is for; this
# secret is what lets the server tell "my app said this" from "some caller
# said this". Without it the server ignores the claim entirely, so a mismatch
# means everyone lands in one ledger rather than silently impersonating.
#
# Set the SAME value in the server's environment (Horizon) and here.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SHARED_SECRET=a-long-random-string
